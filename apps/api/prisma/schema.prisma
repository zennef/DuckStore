generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Color {
  Red
  Green
  Yellow
  Black
}

enum Size {
  XLarge
  Large
  Medium
  Small
  XSmall
}

model Duck {
  id       Int     @id @default(autoincrement())
  color    Color
  size     Size
  /// DOUBLE per the spec. Prices are validated to at most 2 decimal places so merge matching stays exact.
  price    Float
  quantity Int
  deleted  Boolean @default(false)

  /// Supports the merge lookup (color + size + price among non-deleted ducks).
  @@index([color, size, price, deleted])
  @@map("ducks")
}
