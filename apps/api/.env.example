# Root user so `prisma migrate dev` can create its shadow database. Local dev only.
DATABASE_URL="mysql://root:root@localhost:3306/duck_store"
PORT=3000
WEB_ORIGIN="http://localhost:5173"
# Optional. e2e tests default to DATABASE_URL with "_test" appended to the database name.
