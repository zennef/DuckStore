generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Color {
  Red
  Green
  Yellow
  Black
}

enum Size {
  XLarge
  Large
  Medium
  Small
  XSmall
}

model Duck {
  id       Int     @id @default(autoincrement())
  color    Color
  size     Size
  /// DECIMAL instead of the spec's Double so the merge-on-add price match is exact.
  price    Decimal @db.Decimal(10, 2)
  quantity Int
  deleted  Boolean @default(false)

  /// Supports the merge lookup (color + size + price among non-deleted ducks).
  @@index([color, size, price, deleted])
  @@map("ducks")
}
